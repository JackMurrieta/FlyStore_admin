													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 99,
													"top": 966,
													"width": 861,
													"height": 46,
													"text": "La notificación va fuera de la transacción: si WhatsApp falla, el pedido queda pagado y el DTO lleva notificacion_enviada = false\npara que el front ofrezca «Notificar por WhatsApp»."
												},
												{
													"_type": "UMLNoteView",
													"_id": "AAAAAAABjWFj9hffTtg=",
													"_parent": {
														"$ref": "AAAAAAAB20IZYBGzWwU="
													},
													"font": "Arial;13;0",
													"parentStyle": false,
													"left": 99,
													"top": 1528,
													"width": 921,
													"height": 30,
													"text": "El rechazo no libera piezas: el pedido vuelve a pendiente_comprobante con un nuevo plazo de 42 h; si vence, lo cancela el job S6 (Back 5)."
												}
											]
										}
