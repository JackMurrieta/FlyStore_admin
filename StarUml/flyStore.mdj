															"parentStyle": false,
															"left": 3591,
															"top": 256,
															"width": 270,
															"height": 70,
															"text": "Sin clienteId: el gateway envía el JWT en el header Authorization y el backend obtiene el clienteId del token (claim sub)."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhoIiI0gmfTYU=",
