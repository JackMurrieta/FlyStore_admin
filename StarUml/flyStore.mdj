															}
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhyfttGivkzxk=",
															"_parent": {
																"$ref": "AAAAAAGhyfttGivrmDg="
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 4776,
															"top": 40,
															"width": 340,
															"height": 80,
															"text": "Flujo principal (camino feliz). Cada bloque empieza con un Found Message: la llamada que el IGestionarVentaGateway del front envía a la API. Termina con un Lost Message: la respuesta JSON."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhyfttGivlVyE=",
															"_parent": {
																"$ref": "AAAAAAGhyfttGivrmDg="
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 4776,
															"top": 136,
															"width": 340,
															"height": 55,
															"text": "Correspondencia con el diagrama del front: 1 = mensaje 5, 14 = 15, 24 y 32 = 30, 43 = 43, 56 = 62, 78 = 66."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhyfttGivm/oQ=",
															"_parent": {
																"$ref": "AAAAAAGhyfttGivrmDg="
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 4776,
															"top": 207,
															"width": 340,
															"height": 85,
															"text": "Los métodos que estaban en el paquete Reglas ahora son del BO responsable: calcularTotales, generarFolio, validarComprobante, determinarEstadoInicial y calcularFechaLimite en PedidoVentaBO."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhyfttGivnI0w=",
															"_parent": {
																"$ref": "AAAAAAGhyfttGivrmDg="
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 4776,
															"top": 1100.5,
															"width": 340,
															"height": 55,
															"text": "24 y 32: el front los pide juntos al entrar a Método de pago; el folio es el concepto de la transferencia."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhyfttGivoBHA=",
															"_parent": {
																"$ref": "AAAAAAGhyfttGivrmDg="
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 4776,
															"top": 1919,
															"width": 340,
															"height": 70,
															"text": "47: valida formato (JPG, PNG, PDF) y tamaño (máx. 5 MB). El archivo se guarda en Supabase Storage con IComprobanteStorage."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhyfttGivpiIk=",
															"_parent": {
																"$ref": "AAAAAAGhyfttGivrmDg="
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 4776,
															"top": 2469.5,
															"width": 340,
															"height": 85,
															"text": "64: las piezas se descuentan del stock porque el pedido ya trae comprobante de pago. Sin comprobante ni pago no se aparta nada (ver Alt3 y Alt4). 67: transferencia con comprobante = pago en revisión."
														},
														{
															"_type": "UMLNoteView",
															"_id": "AAAAAAGhyfttGivqS2s=",
															"_parent": {
																"$ref": "AAAAAAGhyfttGivrmDg="
															},
															"font": "Arial;13;0",
															"parentStyle": false,
															"left": 4776,
															"top": 3432.5,
															"width": 340,
															"height": 55,
															"text": "78: PROPUESTO. El front lo llama (mensaje 66) pero GestionarVentaController todavía no tiene este método."
														}
													]
												}
											],
